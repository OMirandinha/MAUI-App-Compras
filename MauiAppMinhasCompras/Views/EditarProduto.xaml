<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppMinhasCompras.Views.EditarProduto"
    Title="Editar Produto">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            Text="Salvar"
            Clicked="ToolbarItem_Clicked" />

    </ContentPage.ToolbarItems>

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                x:Name="lbl_codigo"
                Text="Código:"
                TextColor="Gray" />

            <Label
                Text="Descrição do Produto:"
                FontAttributes="Bold" />

            <Entry
                x:Name="txt_descricao"
                Placeholder="Descrição" />

            <Label
                Text="Quantidade:"
                FontAttributes="Bold" />

            <Entry
                x:Name="txt_quantidade"
                Keyboard="Numeric" />

            <Label
                Text="Preço Unitário:"
                FontAttributes="Bold" />

            <Entry
                x:Name="txt_preco"
                Keyboard="Numeric" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>