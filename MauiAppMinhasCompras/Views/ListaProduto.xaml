<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppMinhasCompras.Views.ListaProduto"
    Title="Minhas Compras">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            Text="Somar"
            Clicked="ToolbarItem_Somar" />

        <ToolbarItem
            Text="Adicionar"
            Clicked="ToolbarItem_Clicked" />

    </ContentPage.ToolbarItems>

    <Grid
        Padding="15"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="15">

        <!-- =====================================================
             QUANTIDADE DE PRODUTOS
             ===================================================== -->

        <VerticalStackLayout Grid.Row="0">

            <Label
                Text="Produtos cadastrados"
                FontSize="14"
                TextColor="Gray" />

            <Label
                x:Name="lblQuantidadeProdutos"
                Text="0"
                FontSize="22"
                FontAttributes="Bold" />

        </VerticalStackLayout>


        <!-- =====================================================
             ALTERAÇÃO:
             SEARCHBAR PARA BUSCA DINÂMICA
             ===================================================== -->

        <SearchBar
            Grid.Row="1"
            x:Name="searchBarProdutos"
            Placeholder="Pesquisar produto..."
            TextChanged="SearchBar_TextChanged" />


        <!-- =====================================================
             INFORMAÇÃO PARA O USUÁRIO
             ===================================================== -->

        <Label
            Grid.Row="2"
            Text="Toque em um produto para editar ou excluir."
            FontSize="12"
            TextColor="Gray" />


        <!-- =====================================================
             LISTA DE PRODUTOS
             ===================================================== -->

        <CollectionView
            Grid.Row="3"
            x:Name="collectionViewProdutos"
            SelectionMode="None">

            <!--
                ALTERAÇÃO:
                Mensagem apresentada quando a coleção filtrada
                não possui nenhum resultado.
            -->

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="30"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="Nenhum produto encontrado."
                        FontSize="18"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Tente pesquisar outro produto."
                        FontSize="13"
                        TextColor="Gray"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,5"
                        Padding="15"
                        Stroke="#DDDDDD"
                        StrokeThickness="1">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="10">

                            <!-- DESCRIÇÃO -->

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding Descricao}"
                                FontSize="18"
                                FontAttributes="Bold" />


                            <!-- QUANTIDADE -->

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding Quantidade, StringFormat='Quantidade: {0:F2}'}"
                                FontSize="14"
                                TextColor="Gray" />


                            <!-- PREÇO -->

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="{Binding Preco, StringFormat='Preço unitário: R$ {0:F2}'}"
                                FontSize="14"
                                TextColor="Gray" />


                            <!-- MENU -->

                            <Label
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Grid.Column="1"
                                Text="⋮"
                                FontSize="28"
                                VerticalOptions="Center" />


                            <!--
                                MENU DE CONTEXTO:
                                ao tocar no produto, será aberto
                                o menu Editar / Excluir.
                            -->

                            <Grid.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="Produto_Tapped" />

                            </Grid.GestureRecognizers>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>