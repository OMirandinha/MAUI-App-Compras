<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppMinhasCompras.Views.NovoProduto"
    Title="Novo Produto">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            Text="Salvar"
            Clicked="ToolbarItem_Clicked" />

    </ContentPage.ToolbarItems>

    <ScrollView>

        <VerticalStackLayout
            Spacing="15"
            Padding="20">

            <Label
                Text="Cadastrar Produto"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Informe os dados do produto."
                TextColor="Gray" />

            <Label
                Text="Descrição do Produto:"
                FontAttributes="Bold" />

            <Entry
                x:Name="txt_descricao"
                Placeholder="Ex.: Arroz 5 kg" />

            <Label
                Text="Quantidade:"
                FontAttributes="Bold" />

            <Entry
                x:Name="txt_quantidade"
                Placeholder="Ex.: 2"
                Keyboard="Numeric" />

            <Label
                Text="Preço Unitário:"
                FontAttributes="Bold" />

            <Entry
                x:Name="txt_preco"
                Placeholder="Ex.: 25,90"
                Keyboard="Numeric" />

            <Button
                Text="Salvar Produto"
                Clicked="ToolbarItem_Clicked"
                HeightRequest="50" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>